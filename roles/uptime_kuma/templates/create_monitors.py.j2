#!/usr/bin/env python3
"""由 Ansible 渲染并执行：从 vars/topology.yml 纯通用数据驱动同步 Kuma 监控项。
无需任何设备名称硬编码，统一由 topology.yml 字段自动生成名称、类型与 Markdown 档案卡片。
依赖：pip install uptime-kuma-api-ng（支持 Kuma 1.x/2.x）。
"""
import sys
from uptime_kuma_api import UptimeKumaApi, MonitorType

TYPE_MAP = {
    "http": MonitorType.HTTP,
    "port": MonitorType.PORT,
    "ping": MonitorType.PING,
    "group": MonitorType.GROUP,
}

null = None
false = False
true = True

DEVICES = {{ devices | to_json }}
EXTRA_MONITORS = {{ kuma_monitors | default([]) | to_json }}

GROUP_MAP = {
    "网络基础设施": "网络与服务器",
    "服务器": "网络与服务器",
    "IoT": "IoT 设备",
    "安防": "安防监控",
    "媒体": "媒体设备",
    "终端": "终端设备",
}


def build_target_monitors():
    targets = []
    for d in DEVICES:
        if d.get("monitor") is False or not d.get("ip"):
            continue

        ip = d["ip"]
        name = d["name"]
        mac = d.get("mac")
        note = d.get("note", "")
        conn = d.get("conn_type", "")
        addr = d.get("addr_type", "")
        grp = GROUP_MAP.get(d.get("group"), "其他")

        desc_lines = []
        type_info = f"{conn} · {addr}".strip(" ·")
        if type_info:
            desc_lines.append(f"- **类型**: {type_info}")
        if mac:
            desc_lines.append(f"- **MAC**: `{mac}`")
        if note:
            desc_lines.append(f"- **备注**: {note}")

        # 通用管理后台链接（有显式端口带端口，网关默认 80）
        if d.get("port"):
            desc_lines.append(f"- [🔗 打开管理后台](http://{ip}:{d['port']})")
        elif addr == "网关":
            desc_lines.append(f"- [🔗 打开网关后台](http://{ip})")

        targets.append({
            "name": f"{name} ({ip})",
            "base_name": name,
            "type": "ping",
            "hostname": ip,
            "group": grp,
            "description": "\n".join(desc_lines),
        })

        # 子服务/容器/虚拟机通用展开
        for c in d.get("children", []):
            if c.get("monitor") is False or c.get("name") in ["Uptime Kuma", "Homepage"]:
                continue

            cname = c["name"]
            cport = c.get("port")
            cip = c.get("ip") or ip
            cconn = c.get("conn_type") or conn
            caddr = c.get("addr_type") or "容器"

            c_desc = []
            c_type_info = f"{cconn} · {caddr}".strip(" ·")
            if c_type_info:
                c_desc.append(f"- **类型**: {c_type_info}")
            if c.get("mac"):
                c_desc.append(f"- **MAC**: `{c['mac']}`")
            if c.get("service"):
                c_desc.append(f"- **服务**: {c['service']}")
            if c.get("note"):
                c_desc.append(f"- **备注**: {c['note']}")

            if cport:
                # 数据库等已知协议端口走 port 探测，Web 服务走 http 探测
                if cport in [3306, 5432, 6379, 27017]:
                    targets.append({
                        "name": f"{cname} ({cip}:{cport})",
                        "base_name": cname,
                        "type": "port",
                        "hostname": cip,
                        "port": cport,
                        "group": grp,
                        "description": "\n".join(c_desc),
                    })
                else:
                    c_desc.append(f"- [🔗 打开服务控制台](http://{cip}:{cport})")
                    targets.append({
                        "name": f"{cname} ({cip}:{cport})",
                        "base_name": cname,
                        "type": "http",
                        "url": f"http://{cip}:{cport}",
                        "group": grp,
                        "description": "\n".join(c_desc),
                    })
            else:
                targets.append({
                    "name": f"{cname} ({cip})",
                    "base_name": cname,
                    "type": "ping",
                    "hostname": cip,
                    "group": grp,
                    "description": "\n".join(c_desc),
                })

    for em in EXTRA_MONITORS:
        targets.append(em)

    return targets


def main():
    targets = build_target_monitors()

    with UptimeKumaApi("{{ kuma_api_url }}") as api:
        api.login("{{ kuma_admin_user }}", "{{ kuma_admin_password }}")

        raw = api.get_monitors()
        existing = {m["id"]: m for m in (raw.values() if isinstance(raw, dict) else raw)}

        # 1. 确保所有分组（Group）存在
        group_id_map = {}
        for m in existing.values():
            if m["type"] == MonitorType.GROUP:
                group_id_map[m["name"]] = m["id"]

        for mon in targets:
            grp_name = mon.get("group")
            if grp_name and grp_name not in group_id_map:
                res = api.add_monitor(
                    type=MonitorType.GROUP,
                    name=grp_name,
                )
                gid = res["monitorID"]
                group_id_map[grp_name] = gid
                existing[gid] = {"id": gid, "name": grp_name, "type": MonitorType.GROUP}
                print(f"OK 已创建分组: {grp_name} (ID: {gid})")

        # 2. 遍历监控项：按目标名称、基本名称或IP/URL通用匹配，原地更新或新建
        matched_ids = set()

        for mon in targets:
            target_name = mon["name"]
            base_name = mon.get("base_name", "")
            grp_name = mon.get("group")
            target_parent = group_id_map.get(grp_name) if grp_name else None
            target_desc = mon.get("description", "")

            # 通用匹配：名称完全一致 > 基本名称匹配 > 目标 IP/URL 匹配
            match = None
            for mid, m in existing.items():
                if mid in matched_ids or m["type"] == MonitorType.GROUP:
                    continue
                m_name = m["name"].strip()
                # 1. 完全一致
                if m_name.lower() == target_name.lower():
                    match = m
                    break
                # 2. 基本名匹配（如旧名称 'HoneyWell' 匹配 'HoneyWell (192.168.50.193)'）
                if base_name and (m_name.lower() == base_name.lower() or m_name.lower().startswith(base_name.lower() + " ")):
                    match = m
                    break
                # 3. 别名兼容（'路由器' 匹配 'ASUS TUF Gaming BE6500'，'QNAP' 匹配 'QNAP TS-453Bmini'）
                if (m_name in ["路由器", "QNAP", "HA 主机"]) and (base_name and m_name in base_name):
                    match = m
                    break
                # 4. IP 与类型一致
                if mon.get("hostname") and m.get("hostname") == mon.get("hostname") and m["type"] == TYPE_MAP[mon["type"]]:
                    match = m
                    break
                # 5. URL 一致
                if mon.get("url") and m.get("url") == mon.get("url"):
                    match = m
                    break

            if match:
                matched_ids.add(match["id"])
                curr_id = match["id"]
                curr_name = match.get("name")
                curr_parent = match.get("parent")
                curr_desc = match.get("description", "")

                updates = {}
                if curr_name != target_name:
                    updates["name"] = target_name
                if target_parent is not None and curr_parent != target_parent:
                    updates["parent"] = target_parent
                if curr_desc != target_desc:
                    updates["description"] = target_desc

                if updates:
                    api.edit_monitor(curr_id, **updates)
                    match.update(updates)
                    print(f"OK 已更新: {target_name} -> {list(updates.keys())}")
                else:
                    print(f"SKIP 已存在: {target_name}")
                continue

            # 未匹配到，新建监控项
            kwargs = dict(
                type=TYPE_MAP[mon["type"]],
                name=target_name,
                interval={{ kuma_monitor_interval }},
                maxretries={{ kuma_monitor_maxretries }},
                description=target_desc,
            )
            if target_parent is not None:
                kwargs["parent"] = target_parent

            if mon["type"] == "http":
                kwargs["url"] = mon["url"]
            elif mon["type"] == "port":
                kwargs["hostname"] = mon["hostname"]
                kwargs["port"] = mon["port"]
            else:  # ping
                kwargs["hostname"] = mon["hostname"]

            result = api.add_monitor(**kwargs)
            new_id = result.get("monitorID")
            matched_ids.add(new_id)
            print(f"OK 已创建: {target_name} (ID: {new_id})")


if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        print(f"ERROR: {e}", file=sys.stderr)
        sys.exit(1)
