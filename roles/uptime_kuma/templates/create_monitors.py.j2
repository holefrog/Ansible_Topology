#!/usr/bin/env python3
"""由 Ansible 渲染并执行：幂等地创建 Kuma 监控项。
已存在的监控按名字跳过，不会重复建。临时脚本，执行完即删。
依赖：pip install uptime-kuma-api-ng（支持 Kuma 1.x/2.x）。
"""
import sys
from uptime_kuma_api import UptimeKumaApi, MonitorType

TYPE_MAP = {
    "http": MonitorType.HTTP,
    "port": MonitorType.PORT,
    "ping": MonitorType.PING,
}

MONITORS = {{ kuma_monitors | to_json }}


def main():
    with UptimeKumaApi("{{ kuma_api_url }}") as api:
        api.login("{{ kuma_admin_user }}", "{{ kuma_admin_password }}")

        raw = api.get_monitors()
        if isinstance(raw, dict):
            existing = {m["name"]: m for m in raw.values()}
        else:
            existing = {m["name"]: m for m in raw}

        # 1. 提取所有需要的 Group 并确保存在
        group_id_map = {}
        for m in MONITORS:
            grp_name = m.get("group")
            if grp_name and grp_name not in group_id_map:
                if grp_name in existing:
                    group_id_map[grp_name] = existing[grp_name]["id"]
                else:
                    res = api.add_monitor(
                        type=MonitorType.GROUP,
                        name=grp_name,
                    )
                    gid = res["monitorID"]
                    group_id_map[grp_name] = gid
                    existing[grp_name] = {"id": gid, "name": grp_name, "type": "group"}
                    print(f"OK 已创建分组: {grp_name} (ID: {gid})")

        # 2. 遍历监控项：创建或移动所属分组
        for mon in MONITORS:
            name = mon["name"]
            grp_name = mon.get("group")
            target_parent = group_id_map.get(grp_name) if grp_name else None

            if name in existing:
                curr = existing[name]
                curr_parent = curr.get("parent")
                # 如果已存在但分组不一致，移入目标分组
                if target_parent is not None and curr_parent != target_parent:
                    api.edit_monitor(curr["id"], parent=target_parent)
                    curr["parent"] = target_parent
                    print(f"OK 已归类: {name} -> 移入分组 [{grp_name}]")
                else:
                    print(f"SKIP 已存在: {name}")
                continue

            kwargs = dict(
                type=TYPE_MAP[mon["type"]],
                name=name,
                interval={{ kuma_monitor_interval }},
                maxretries={{ kuma_monitor_maxretries }},
            )
            if target_parent is not None:
                kwargs["parent"] = target_parent

            if mon["type"] == "http":
                kwargs["url"] = mon["url"]
            elif mon["type"] == "port":
                kwargs["hostname"] = mon["hostname"]
                kwargs["port"] = mon["port"]
            else:  # ping
                kwargs["hostname"] = mon["hostname"]
            result = api.add_monitor(**kwargs)
            print(f"OK 已创建: {name} -> {result}")


if __name__ == "__main__":
    try:
        main()
    except Exception as e:  # noqa: BLE001 - 报错直接抛给 Ansible 看
        print(f"ERROR: {e}", file=sys.stderr)
        sys.exit(1)
