<!--
  本文件由 vars/topology.yml 自动渲染，请勿手改
  渲染命令：ansible-playbook site.yml --tags topology
  输出为 Markdown（含 mermaid 代码块），推到 GitHub 后自动成图
-->

```mermaid
flowchart TD
    Internet([Internet<br/>外网入口])
{% set ns = namespace(i=0, router='', qnap='', sg_count=0) %}
{% set group_order = ['网络基础设施', '服务器', '安防', 'IoT', '媒体', '终端', '云端'] %}
{% for gname in group_order %}
{% set glist = devices | selectattr('group', 'equalto', gname) | list %}
{% if glist | length > 0 %}
{% set ns.sg_count = ns.sg_count + 1 %}

    subgraph SG{{ ns.sg_count }}["{{ gname }}{% if gname == '云端' %} · Phase 2{% endif %}"]
        direction LR
{% for d in glist %}
{% set ns.i = ns.i + 1 %}{% set pid = 'D' ~ ns.i %}
{% if gname == '网络基础设施' and loop.first %}{% set ns.router = pid %}{% endif %}
{% if 'QNAP' in d.name %}{% set ns.qnap = pid %}{% endif %}
        {{ pid }}["{{ d.name }}{% if d.get('ip') %}<br/>{{ d.ip }}{% elif d.get('monitor') is not none and not d.get('monitor') %}<br/>动态{% endif %}{% if d.get('note') and '⚠' in d.get('note') %} ⚠{% endif %}"]{% if d.get('note') and '⚠' in d.get('note') %}:::warn{% endif %}

{% if d.get('children') %}
{% for c in d.children %}
{% set ns.i = ns.i + 1 %}
        D{{ ns.i }}["{{ c.name }}{% if c.get('port') %}<br/>:{{ c.get('port') }}{% endif %}"]
        {{ pid }} --- D{{ ns.i }}
{% endfor %}
{% endif %}
{% endfor %}
    end
{% endif %}
{% endfor %}

{% if ns.router %}
    Internet --> {{ ns.router }}
{% endif %}
{% if ns.router and ns.qnap %}
    {{ ns.router }} --> {{ ns.qnap }}
{% endif %}

    %% 垂直约束：保证各分组自上而下逐行排列（一行一条），避免横向拉成过长长条
{% for idx in range(1, ns.sg_count) %}
    SG{{ idx }} ~~~ SG{{ idx + 1 }}
{% endfor %}

    classDef warn fill:#fef2f2,stroke:#ef4444,color:#991b1b;
```
